import { useState, useMemo } from 'react';

export default function ObesityMNTCalculator() {
  const [sex, setSex] = useState('female');
  const [age, setAge] = useState('');
  const [heightFt, setHeightFt] = useState('');
  const [heightIn, setHeightIn] = useState('');
  const [weightLb, setWeightLb] = useState('');
  const [geriatric, setGeriatric] = useState(false);
  const [onGLP, setOnGLP] = useState(false);
  const [activityLevel, setActivityLevel] = useState('1.3');
  const [goal, setGoal] = useState('loss');

  const results = useMemo(() => {
    const ageNum = parseFloat(age);
    const ftNum = parseFloat(heightFt);
    const inNum = parseFloat(heightIn) || 0;
    const wtLbNum = parseFloat(weightLb);

    if (!ageNum || !ftNum || !wtLbNum) return null;

    const totalInches = ftNum * 12 + inNum;
    const heightCm = totalInches * 2.54;
    const abwKg = wtLbNum * 0.453592;

    // IBW (Hamwi) in lb, then kg
    const inchesOver5ft = Math.max(totalInches - 60, 0);
    const ibwLb = sex === 'male'
      ? 106 + 6 * inchesOver5ft
      : 100 + 5 * inchesOver5ft;
    const ibwKg = ibwLb * 0.453592;

    const bmi = (wtLbNum / (totalInches * totalInches)) * 703;

    // Adjusted body weight
    const adjBWKg = ibwKg + 0.25 * (abwKg - ibwKg);

    // Decide which weight to use for energy
    const useAdj = bmi >= 35;
    const energyWeightKg = useAdj ? adjBWKg : abwKg;
    const energyWeightLabel = useAdj ? 'Adjusted Body Weight' : 'Actual Body Weight';

    // Mifflin-St Jeor
    let bmr = sex === 'male'
      ? (10 * energyWeightKg) + (6.25 * heightCm) - (5 * ageNum) + 5
      : (10 * energyWeightKg) + (6.25 * heightCm) - (5 * ageNum) - 161;

    const actFactor = parseFloat(activityLevel);
    let tdee = bmr * actFactor;

    // Reduce 5-10% if BMI >= 35 (using midpoint 7.5%)
    if (bmi >= 35) {
      tdee = tdee * 0.925;
    }

    // Geriatric adjustment note - conservative activity factor already reflects this via selection,
    // but flag conservative deficit approach
    let deficit = 0;
    let targetKcal = tdee;
    if (goal === 'loss') {
      deficit = geriatric ? 500 : 625; // smaller deficit for geriatric safety
      targetKcal = tdee - deficit;
    }

    // Safety floor
    const floor = sex === 'male' ? 1500 : 1200;
    const floorApplied = targetKcal < floor;
    if (floorApplied) targetKcal = floor;

    // Protein calculations
    const proteinLow_ABW = 1.2 * abwKg;
    const proteinLow_IBW = 2.0 * ibwKg;
    const proteinHigh_IBW = 2.5 * ibwKg;

    // Determine recommended protein range based on flags
    let proteinTargetLow, proteinTargetHigh, proteinNote;
    if (bmi >= 40 || onGLP) {
      proteinTargetLow = proteinLow_IBW;
      proteinTargetHigh = proteinHigh_IBW;
      proteinNote = onGLP
        ? 'Higher end favored: on GLP-1 therapy (lean mass preservation with reduced intake)'
        : 'Higher end favored: Class III obesity (higher protein needed for nitrogen balance)';
    } else {
      proteinTargetLow = Math.min(proteinLow_ABW, proteinLow_IBW);
      proteinTargetHigh = Math.max(proteinLow_ABW, proteinLow_IBW);
      proteinNote = 'Standard range for BMI 30–39 without additional risk factors';
    }

    // Fluid
    const fluidWeightKg = bmi >= 40 ? adjBWKg : abwKg;
    const fluidWeightLabel = bmi >= 40 ? 'Adjusted Body Weight' : 'Actual Body Weight';
    const fluidLow = fluidWeightKg * 25;
    const fluidHigh = fluidWeightKg * 35;
    const fluidFromKcal = targetKcal * 1; // 1 mL per kcal

    // Geriatric fluid caution
    const geriatricFluidNote = geriatric;

    return {
      bmi,
      ibwLb,
      ibwKg,
      abwKg,
      adjBWKg,
      energyWeightKg,
      energyWeightLabel,
      bmr,
      tdee,
      deficit,
      targetKcal,
      floorApplied,
      floor,
      proteinTargetLow,
      proteinTargetHigh,
      proteinNote,
      fluidLow,
      fluidHigh,
      fluidFromKcal,
      fluidWeightLabel,
      geriatricFluidNote,
      useAdj,
    };
  }, [sex, age, heightFt, heightIn, weightLb, geriatric, onGLP, activityLevel, goal]);

  const bmiCategory = (bmi) => {
    if (bmi < 30) return { label: 'Not obese (BMI <30) — general adult formulas may apply instead', color: 'text-amber-600' };
    if (bmi < 35) return { label: 'Class I Obesity', color: 'text-blue-600' };
    if (bmi < 40) return { label: 'Class II Obesity', color: 'text-orange-600' };
    return { label: 'Class III Obesity (Severe)', color: 'text-red-600' };
  };

  const inputClass = "w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 text-sm";
  const labelClass = "block text-xs font-medium text-slate-600 mb-1";

  return (
    <div className="min-h-screen bg-slate-50 py-6 px-4">
      <div className="max-w-2xl mx-auto">
        <div className="text-center mb-6">
          <h1 className="text-xl font-bold text-slate-800">Obesity MNT Calculator</h1>
          <p className="text-sm text-slate-500">Outpatient Energy, Protein & Fluid Estimator (BMI ≥30)</p>
        </div>

        <div className="bg-white rounded-xl shadow-sm border border-slate-200 p-5 mb-4">
          <h2 className="text-sm font-semibold text-slate-700 mb-3">Patient Info</h2>
          <div className="grid grid-cols-2 gap-3 mb-3">
            <div>
              <label className={labelClass}>Sex</label>
              <select value={sex} onChange={(e) => setSex(e.target.value)} className={inputClass}>
                <option value="female">Female</option>
                <option value="male">Male</option>
              </select>
            </div>
            <div>
              <label className={labelClass}>Age (years)</label>
              <input type="number" value={age} onChange={(e) => setAge(e.target.value)} className={inputClass} placeholder="e.g. 58" />
            </div>
          </div>

          <div className="grid grid-cols-3 gap-3 mb-3">
            <div>
              <label className={labelClass}>Height (ft)</label>
              <input type="number" value={heightFt} onChange={(e) => setHeightFt(e.target.value)} className={inputClass} placeholder="5" />
            </div>
            <div>
              <label className={labelClass}>Height (in)</label>
              <input type="number" value={heightIn} onChange={(e) => setHeightIn(e.target.value)} className={inputClass} placeholder="7" />
            </div>
            <div>
              <label className={labelClass}>Weight (lb)</label>
              <input type="number" value={weightLb} onChange={(e) => setWeightLb(e.target.value)} className={inputClass} placeholder="245" />
            </div>
          </div>

          <div className="grid grid-cols-2 gap-3 mb-3">
            <label className="flex items-center gap-2 px-3 py-2 border border-slate-200 rounded-lg cursor-pointer hover:bg-slate-50">
              <input type="checkbox" checked={geriatric} onChange={(e) => setGeriatric(e.target.checked)} className="w-4 h-4 accent-teal-600" />
              <span className="text-sm text-slate-700">Geriatric (65+)</span>
            </label>
            <label className="flex items-center gap-2 px-3 py-2 border border-slate-200 rounded-lg cursor-pointer hover:bg-slate-50">
              <input type="checkbox" checked={onGLP} onChange={(e) => setOnGLP(e.target.checked)} className="w-4 h-4 accent-teal-600" />
              <span className="text-sm text-slate-700">On GLP-1 therapy</span>
            </label>
          </div>

          <div className="grid grid-cols-2 gap-3">
            <div>
              <label className={labelClass}>Activity Level</label>
              <select value={activityLevel} onChange={(e) => setActivityLevel(e.target.value)} className={inputClass}>
                <option value="1.2">Sedentary (1.2)</option>
                <option value="1.3">Light activity (1.3)</option>
                <option value="1.4">Moderate activity (1.4)</option>
                <option value="1.5">Active (1.5)</option>
              </select>
            </div>
            <div>
              <label className={labelClass}>Goal</label>
              <select value={goal} onChange={(e) => setGoal(e.target.value)} className={inputClass}>
                <option value="loss">Weight loss</option>
                <option value="maintain">Maintenance</option>
              </select>
            </div>
          </div>
        </div>

        {results && (
          <div className="space-y-4">
            {/* BMI Card */}
            <div className="bg-white rounded-xl shadow-sm border border-slate-200 p-5">
              <div className="flex justify-between items-center">
                <div>
                  <p className="text-xs text-slate-500">BMI</p>
                  <p className="text-2xl font-bold text-slate-800">{results.bmi.toFixed(1)}</p>
                </div>
                <div className="text-right">
                  <p className={`text-sm font-semibold ${bmiCategory(results.bmi).color}`}>
                    {bmiCategory(results.bmi).label}
                  </p>
                </div>
              </div>
              <div className="grid grid-cols-3 gap-2 mt-3 pt-3 border-t border-slate-100 text-center">
                <div>
                  <p className="text-xs text-slate-400">IBW</p>
                  <p className="text-sm font-medium text-slate-700">{results.ibwLb.toFixed(0)} lb</p>
                </div>
                <div>
                  <p className="text-xs text-slate-400">ABW</p>
                  <p className="text-sm font-medium text-slate-700">{(results.abwKg / 0.453592).toFixed(0)} lb</p>
                </div>
                <div>
                  <p className="text-xs text-slate-400">AdjBW</p>
                  <p className="text-sm font-medium text-slate-700">{(results.adjBWKg / 0.453592).toFixed(0)} lb</p>
                </div>
              </div>
            </div>

            {/* Energy Card */}
            <div className="bg-teal-50 rounded-xl border border-teal-200 p-5">
              <h3 className="text-sm font-bold text-teal-800 mb-2">STEP 1 — Energy</h3>
              <p className="text-xs text-teal-700 mb-3">
                Weight used: <span className="font-semibold">{results.energyWeightLabel}</span>
                {results.useAdj && <span> (BMI ≥35 → 5–10% reduction applied)</span>}
              </p>
              <div className="grid grid-cols-2 gap-3 mb-3">
                <div className="bg-white rounded-lg p-3">
                  <p className="text-xs text-slate-500">Estimated TDEE</p>
                  <p className="text-lg font-bold text-slate-800">{Math.round(results.tdee)} kcal</p>
                </div>
                <div className="bg-white rounded-lg p-3">
                  <p className="text-xs text-slate-500">{goal === 'loss' ? `Target (−${results.deficit} kcal)` : 'Target (maintenance)'}</p>
                  <p className="text-lg font-bold text-teal-700">{Math.round(results.targetKcal)} kcal</p>
                </div>
              </div>
              {results.floorApplied && (
                <p className="text-xs bg-amber-100 text-amber-800 rounded-lg px-3 py-2">
                  ⚠ Calculated deficit fell below the safety floor ({results.floor} kcal) — floor applied instead. Reassess deficit size or monitor closely.
                </p>
              )}
              {geriatric && goal === 'loss' && (
                <p className="text-xs bg-blue-100 text-blue-800 rounded-lg px-3 py-2 mt-2">
                  ℹ Geriatric: smaller deficit (500 kcal) applied to protect against sarcopenia/frailty risk with weight loss.
                </p>
              )}
            </div>

            {/* Protein Card */}
            <div className="bg-purple-50 rounded-xl border border-purple-200 p-5">
              <h3 className="text-sm font-bold text-purple-800 mb-2">STEP 2 — Protein</h3>
              <div className="bg-white rounded-lg p-3 mb-2">
                <p className="text-xs text-slate-500">Target range</p>
                <p className="text-lg font-bold text-purple-700">
                  {Math.round(results.proteinTargetLow)}–{Math.round(results.proteinTargetHigh)} g/day
                </p>
              </div>
              <p className="text-xs text-purple-700">{results.proteinNote}</p>
              {geriatric && (
                <p className="text-xs bg-blue-100 text-blue-800 rounded-lg px-3 py-2 mt-2">
                  ℹ Geriatric: favor the higher end of range to counter age-related anabolic resistance and sarcopenia risk.
                </p>
              )}
              <p className="text-xs text-slate-500 mt-2">Spread across meals/snacks — especially important if appetite is reduced (GLP-1) or meal volume is small.</p>
            </div>

            {/* Fluid Card */}
            <div className="bg-blue-50 rounded-xl border border-blue-200 p-5">
              <h3 className="text-sm font-bold text-blue-800 mb-2">STEP 3 — Fluid</h3>
              <p className="text-xs text-blue-700 mb-3">
                Weight used: <span className="font-semibold">{results.fluidWeightLabel}</span>
                {results.bmi >= 40 && <span> (BMI ≥40)</span>}
              </p>
              <div className="grid grid-cols-2 gap-3">
                <div className="bg-white rounded-lg p-3">
                  <p className="text-xs text-slate-500">25–35 mL/kg</p>
                  <p className="text-lg font-bold text-slate-800">{Math.round(results.fluidLow)}–{Math.round(results.fluidHigh)} mL</p>
                </div>
                <div className="bg-white rounded-lg p-3">
                  <p className="text-xs text-slate-500">1 mL/kcal cross-check</p>
                  <p className="text-lg font-bold text-blue-700">{Math.round(results.fluidFromKcal)} mL</p>
                </div>
              </div>
              <p className="text-xs text-slate-500 mt-2">Adjust to thirst, urine color, edema — not just the number. Restrict per protocol if renal/cardiac/hepatic comorbidity present.</p>
            </div>

            <p className="text-xs text-center text-slate-400 pt-2">
              Estimates only — clinical judgment, labs, and reassessment at follow-up override calculated values.
            </p>
          </div>
        )}

        {!results && (
          <div className="bg-white rounded-xl border border-dashed border-slate-300 p-8 text-center text-sm text-slate-400">
            Enter age, height, and weight to see calculations.
          </div>
        )}
      </div>
    </div>
  );
}
